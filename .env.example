# ── AI 판정 (필수) ────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── 데이터 계층 ───────────────────────────────────────────────────────────────
# true면 data/cases/*.json + data/history.json 을 사용한다.
# NEXT_PUBLIC_SUPABASE_URL이 비어 있어도 자동으로 파일 DB로 폴백된다.
# (단, 멀티플레이 방 기능은 Supabase가 있어야 동작한다.)
USE_FILE_DB=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 관리자 ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me
# 32자 이상이어야 한다 (미달 시 로그인 시 에러)
ADMIN_SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# ── 선택 ──────────────────────────────────────────────────────────────────────
# 공유 링크 등에 쓰이는 절대 URL
BASE_URL=http://127.0.0.1:3000
